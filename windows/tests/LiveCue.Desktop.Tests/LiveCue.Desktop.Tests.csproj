<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop's session, view models, theme dictionaries and contracts (test plan sections 2.6 to 2.9).
    No UI automation: the window itself is exercised by the app's own self-test
    (LiveCueRemake.exe - -self-test), which CI runs against the published build. The shared helpers of
    tests/Shared are linked in by Directory.Build.props.
  -->

  <PropertyGroup>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LiveCue.Desktop\LiveCue.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects leave these two out of the implicit usings. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
