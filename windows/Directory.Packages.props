<Project>

  <!--
    Central package management: every package version used under windows/ is pinned here.

    These six are the only packages the architecture allows (docs/architecture/03-system-architecture.md,
    section 3.1). Adding another needs a decision first, because this PC allows package restores only,
    never new tooling.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="LiveCue.Relay">
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="LiveCue.Desktop">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
