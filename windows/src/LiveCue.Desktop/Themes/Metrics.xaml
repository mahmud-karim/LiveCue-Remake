<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Sizes that do not change with the theme: radii, insets, control heights, icon sizes and motion.
    Design system sections 2.11, 2.12, 2.16, 2.17 and 2.18. All values are device-independent pixels.

    radius.pill has no key: a pill's radius is half its own height, which Pill.IsPill computes from
    the laid-out element (a fixed number would break as soon as the text scale grows a control).
  -->

  <!-- 2.12 Radii -->
  <CornerRadius x:Key="RadiusPanel">30</CornerRadius>
  <CornerRadius x:Key="RadiusCard">22</CornerRadius>
  <CornerRadius x:Key="RadiusField">16</CornerRadius>
  <CornerRadius x:Key="RadiusTile">12</CornerRadius>
  <CornerRadius x:Key="RadiusTileSmall">10</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
  <!--
    Two radii from the screen design (docs/design/03-windows-screens.md and its mockups) that the
    design system's table does not list: the compact one-line panel, and a card nested in the sidebar,
    which is concentric with it (radius.panel 30 minus the sidebar's padding of 10).
  -->
  <CornerRadius x:Key="RadiusPanelCompact">26</CornerRadius>
  <CornerRadius x:Key="RadiusCardInSidebar">20</CornerRadius>

  <!-- 2.11 Spacing aliases (Windows column) -->
  <Thickness x:Key="InsetPanel">20</Thickness>
  <Thickness x:Key="InsetPanelCompact">20,14</Thickness>
  <Thickness x:Key="InsetCard">16</Thickness>
  <!-- A panel that holds rows is padded by 8, so a row's hover shape (radius.card) stays concentric. -->
  <Thickness x:Key="InsetPanelRows">8</Thickness>
  <!-- The sidebar: padded by 10, so its 44-high rows (radius 22) and its status card (radius 20) nest in radius 30. -->
  <Thickness x:Key="InsetSidebar">10</Thickness>
  <sys:Double x:Key="InsetScreen">16</sys:Double>
  <sys:Double x:Key="GapPanel">16</sys:Double>
  <sys:Double x:Key="GapGroup">12</sys:Double>
  <sys:Double x:Key="GapInline">8</sys:Double>
  <sys:Double x:Key="GapControl">8</sys:Double>
  <sys:Double x:Key="SizeSidebar">232</sys:Double>
  <sys:Double x:Key="SizeTitleBar">48</sys:Double>
  <!-- The page header row: the view's name on the left, its main actions on the right. -->
  <sys:Double x:Key="SizePageHeader">48</sys:Double>
  <!-- Pairing: the panel that holds the QR tile. -->
  <sys:Double x:Key="SizeQrPanel">304</sys:Double>
  <!-- 2.10: reading width of transcript and cue text. -->
  <sys:Double x:Key="SizeReadingMax">720</sys:Double>

  <!-- 2.16 Hit targets and component heights. Heights are minimums: controls grow with their text. -->
  <!-- The session control (4.17): the big start control in a page header. -->
  <sys:Double x:Key="ButtonHeightSession">48</sys:Double>
  <Thickness x:Key="ButtonPaddingSession">24,0</Thickness>
  <sys:Double x:Key="FieldHeight">44</sys:Double>
  <sys:Double x:Key="ButtonHeightLarge">44</sys:Double>
  <sys:Double x:Key="ButtonHeightRegular">40</sys:Double>
  <sys:Double x:Key="ButtonHeightQuiet">36</sys:Double>
  <sys:Double x:Key="ButtonHeightCompact">32</sys:Double>
  <Thickness x:Key="ButtonPaddingLarge">22,0</Thickness>
  <Thickness x:Key="ButtonPaddingRegular">20,0</Thickness>
  <Thickness x:Key="ButtonPaddingCompact">14,0</Thickness>
  <sys:Double x:Key="NavRowHeight">44</sys:Double>
  <sys:Double x:Key="RowHeightOneLine">48</sys:Double>
  <sys:Double x:Key="RowHeightTwoLine">60</sys:Double>
  <sys:Double x:Key="RowTileSize">32</sys:Double>
  <sys:Double x:Key="ChipHeight">28</sys:Double>
  <Thickness x:Key="ChipPadding">10,0</Thickness>
  <sys:Double x:Key="CaptionButtonWidth">44</sys:Double>
  <sys:Double x:Key="CaptionButtonHeight">34</sys:Double>

  <!-- 2.18 Icon sizes -->
  <sys:Double x:Key="IconSizeSmall">16</sys:Double>
  <sys:Double x:Key="IconSizeRegular">20</sys:Double>
  <sys:Double x:Key="IconSizeLarge">24</sys:Double>

  <!-- 2.17 Motion -->
  <Duration x:Key="MotionPress">0:0:0.1</Duration>
  <Duration x:Key="MotionFast">0:0:0.16</Duration>
  <Duration x:Key="MotionBase">0:0:0.24</Duration>
  <Duration x:Key="MotionEmphasis">0:0:0.36</Duration>
  <KeySpline x:Key="EaseStandard">0.2,0 0,1</KeySpline>
  <KeySpline x:Key="EaseOut">0,0 0.2,1</KeySpline>
  <KeySpline x:Key="EaseIn">0.4,0 1,1</KeySpline>
  <KeySpline x:Key="EaseInOut">0.4,0 0.6,1</KeySpline>

</ResourceDictionary>
