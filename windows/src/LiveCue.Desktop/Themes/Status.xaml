<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LiveCue.Desktop.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    Status (design system 4.12 and 4.22). Colour is never the only signal: every state has its own
    mark shape and is shown next to a label in words.

      Neutral   hollow ring, 1.5 stroke     status.offline
      Live      filled dot                  status.live
      Success   filled dot                  status.success
      Warning   filled dot                  status.warning
      Danger    alert glyph, 14             status.danger
  -->

  <!-- The mark on its own, for inline status: the label beside it stays ink.primary (rules C-1, C-4). -->
  <Style TargetType="ui:StatusMarkView">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource StatusOfflineBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:StatusMarkView">
          <Grid>
            <Ellipse x:Name="Ring" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
            <Ellipse x:Name="Dot" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
            <ui:Icon x:Name="Alert"
                     Glyph="{StaticResource Icon.Alert}"
                     Foreground="{TemplateBinding Foreground}"
                     Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="Live">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Kind" Value="Success">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Alert" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Live">
        <Setter Property="Foreground" Value="{DynamicResource StatusLiveBrush}" />
      </Trigger>
      <Trigger Property="Kind" Value="Success">
        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
      </Trigger>
      <Trigger Property="Kind" Value="Warning">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
      </Trigger>
      <Trigger Property="Kind" Value="Danger">
        <Setter Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Status chip: a capsule that brings its own base. surface.raised, then the status tint, then the
    mark and the label in the status colour. On a bare tint the accent and danger labels would fall
    to 4.19:1; on the raised base they are at least 4.78:1 (design system, table C).
  -->
  <Style x:Key="Chip" TargetType="ui:StatusChip">
    <Setter Property="MinHeight" Value="{DynamicResource ChipHeight}" />
    <Setter Property="Padding" Value="{DynamicResource ChipPadding}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource StatusOfflineBrush}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:StatusChip">
          <Grid>
            <Border x:Name="Base" ui:Pill.IsPill="True" Background="{DynamicResource SurfaceRaisedBrush}" />
            <Border x:Name="Tint"
                    ui:Pill.IsPill="True"
                    Background="{DynamicResource StatusOfflineTintBrush}"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:StatusMarkView Kind="{TemplateBinding Kind}" Margin="0,0,6,0" />
                <TextBlock Text="{TemplateBinding Text}"
                           Style="{DynamicResource Type.Caption}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFloating" Value="True">
              <Setter TargetName="Base" Property="Effect" Value="{DynamicResource ShadowRaised}" />
            </Trigger>
            <Trigger Property="Kind" Value="Live">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusLiveTintBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Success">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusSuccessTintBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Warning">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusWarningTintBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusDangerTintBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Live">
        <Setter Property="Foreground" Value="{DynamicResource StatusLiveBrush}" />
      </Trigger>
      <Trigger Property="Kind" Value="Success">
        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
      </Trigger>
      <Trigger Property="Kind" Value="Warning">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
      </Trigger>
      <Trigger Property="Kind" Value="Danger">
        <Setter Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ui:StatusChip" BasedOn="{StaticResource Chip}" />

  <!--
    Inline status indicator (design system 4.22): the mark, 8 from it the label in type.label and
    ink.primary; only the mark is coloured (rules C-1, C-4). The label wraps, and the mark stays
    beside its first line. Each mark has its own shape:

      Ring      hollow, 8, 1.5 stroke     Dot     filled, 8         Spinner  12, turning
      Pause     the pause glyph, 14       Alert   the alert glyph, 14   Check  the check glyph, 14

    The tone picks the colour through Foreground, which every mark draws with.
  -->
  <Style x:Key="Indicator" TargetType="ui:StatusIndicatorView">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource StatusOfflineBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:StatusIndicatorView">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- As high as one line of the label, so the mark is centred on the first line however far the text wraps. -->
            <Grid Height="{DynamicResource TypeLabelLineHeight}" Margin="0,0,8,0" VerticalAlignment="Top">
              <Ellipse x:Name="Ring"
                       Width="8"
                       Height="8"
                       VerticalAlignment="Center"
                       Stroke="{TemplateBinding Foreground}"
                       StrokeThickness="1.5" />
              <Ellipse x:Name="Dot"
                       Width="8"
                       Height="8"
                       VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}"
                       Visibility="Collapsed" />
              <ui:Spinner x:Name="Turning"
                          Width="12"
                          Height="12"
                          VerticalAlignment="Center"
                          Foreground="{TemplateBinding Foreground}"
                          Visibility="Collapsed" />
              <ui:Icon x:Name="Glyph"
                       Width="14"
                       Height="14"
                       VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"
                       Visibility="Collapsed" />
            </Grid>

            <TextBlock Grid.Column="1"
                       Text="{TemplateBinding Text}"
                       Style="{DynamicResource Type.Label}"
                       Foreground="{DynamicResource InkPrimaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="None" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Mark" Value="Dot">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Mark" Value="Spinner">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Turning" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Mark" Value="Pause">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
              <Setter TargetName="Glyph" Property="Glyph" Value="{StaticResource Icon.Pause}" />
            </Trigger>
            <Trigger Property="Mark" Value="Alert">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
              <Setter TargetName="Glyph" Property="Glyph" Value="{StaticResource Icon.Alert}" />
            </Trigger>
            <Trigger Property="Mark" Value="Check">
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
              <Setter TargetName="Glyph" Property="Glyph" Value="{StaticResource Icon.Check}" />
              <Setter TargetName="Glyph" Property="StrokeThickness" Value="2.6" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Live">
        <Setter Property="Foreground" Value="{DynamicResource StatusLiveBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Success">
        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Warning">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
      </Trigger>
      <Trigger Property="Tone" Value="Danger">
        <Setter Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ui:StatusIndicatorView" BasedOn="{StaticResource Indicator}" />

  <!--
    Spinner (design system 4.13): a 270-degree arc in the current text colour, one turn in 900 ms.
    20 across here; set Width and Height to 16 in a button and to 12 in a chip or an indicator. The
    control draws and turns itself, so there is no template. Give it an automation name, or put it
    beside a text that says what is in progress.
  -->
  <Style x:Key="Spinner" TargetType="ui:Spinner">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template" Value="{x:Null}" />
  </Style>

  <Style TargetType="ui:Spinner" BasedOn="{StaticResource Spinner}" />

</ResourceDictionary>
