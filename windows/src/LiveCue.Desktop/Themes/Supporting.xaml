<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LiveCue.Desktop.Controls">

  <!--
    Supporting elements (design system 4.14 and 4.23): tooltip, page frame, page scroller, divider,
    scrollbar, log text, empty state.
  -->

  <!--
    Tooltip: surface.inverse, radius.small, padding 8 / 6, type.caption in ink.onInverse, shadow.raised,
    at most 320 wide with the text wrapping. A tooltip is its own transparent window, where ClearType
    is not available, so greyscale is asked for explicitly (3.5, rule 9). The margin around the tile
    is room for its shadow inside that window. The 500 ms delay is set once for the whole app in
    App.xaml.cs.
  -->
  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="HorizontalOffset" Value="-12" />
    <Setter Property="VerticalOffset" Value="-2" />
    <Setter Property="MaxWidth" Value="344" />
    <Setter Property="Foreground" Value="{DynamicResource InkOnInverseBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeCaptionSize}" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="12,8,12,16">
            <Border CornerRadius="{DynamicResource RadiusSmall}"
                    Background="{DynamicResource SurfaceInverseBrush}"
                    Effect="{DynamicResource ShadowRaised}" />
            <Border CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6">
              <ContentPresenter TextBlock.LineHeight="{DynamicResource TypeCaptionLineHeight}"
                                TextBlock.LineStackingStrategy="BlockLineHeight">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The frame every page shares (screens 1.4): a header 48 high on the ground with the view's name in
    type.display on the left and the page's main actions on the right, then, 16 below, the page's
    panels. Title and actions are 4 in from the panels' edges, as in the mockups.
  -->
  <Style TargetType="ui:PageLayout">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:PageLayout">
          <DockPanel>
            <Grid DockPanel.Dock="Top" MinHeight="{DynamicResource SizePageHeader}" Margin="4,0,4,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Title}"
                         Style="{DynamicResource Type.Display}"
                         Foreground="{DynamicResource InkPrimaryBrush}"
                         VerticalAlignment="Center"
                         AutomationProperties.HeadingLevel="Level1" />
              <ContentPresenter Grid.Column="1"
                                ContentSource="HeaderContent"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center" />
            </Grid>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The scroller of a view that scrolls (Pairing at the minimum height, Settings). A ScrollViewer
    clips what it scrolls to its viewport, which would cut a panel's shadow off at the edge of the
    page. So the scroller reaches into the gaps around the page (InsetScrollerOutset) and the view
    puts the same distance back as the margin of its content (InsetScrollerContent). The scrollbar
    then sits in the window's own inset. Nothing translucent floats over what scrolls (rule W-1).

    Do not use ScrollViewer.Padding for this: it shrinks the clipping presenter instead of the content.
  -->
  <Thickness x:Key="InsetScrollerOutset">-16,-8,-16,-16</Thickness>
  <Thickness x:Key="InsetScrollerContent">16,8,16,16</Thickness>

  <Style x:Key="Page.Scroller" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="{StaticResource InsetScrollerOutset}" />
  </Style>

  <!-- Divider: stroke.hairline, 1 px. Decorative, carries no meaning. -->
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource StrokeHairlineBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Scrollbar: 12 wide gutter, no track fill, no arrow buttons; thumb 6 wide, radius 3. -->
  <Style x:Key="Scroll.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ControlScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- The transparent grid is the hit target; the visible thumb is the 6 px bar inside it. -->
          <Grid Background="Transparent">
            <Border x:Name="Bar" Margin="3" CornerRadius="3" Background="{TemplateBinding Background}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ControlScrollThumbHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ControlScrollThumbHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Scroll.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource Scroll.Thumb}" MinHeight="32" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource Scroll.Thumb}" MinWidth="32" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    4.23 Log text: one entry of the activity log. type.mono, lines wrap. Message text is ink.primary;
    set InkSecondaryBrush on the runs of a timestamp or a payload.
  -->
  <Style x:Key="Log.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeMonoSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource TypeMonoLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--
    4.14 Empty state: centred in the panel it explains, at most 340 wide with 28 around it, its text
    centred. The content is the page's: the tile below, 16 under it the title in type.title, 6 under
    that the body in type.body and ink.secondary, and at most one button.
  -->
  <Style x:Key="EmptyState" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MaxWidth" Value="340" />
    <Setter Property="Margin" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="TextBlock.TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
  </Style>

  <!--
    The icon tile of an empty state: 64, radius.card, a surface.raised base under accent.tint, and a
    28 glyph in the accent. Its content is the glyph: a ui:Icon 28 wide and high.
  -->
  <Style x:Key="EmptyState.Tile" TargetType="ContentControl">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource SurfaceRaisedBrush}" />
            <Border CornerRadius="{DynamicResource RadiusCard}"
                    Background="{DynamicResource AccentTintBrush}"
                    BorderBrush="{DynamicResource StrokeRaisedBrush}"
                    BorderThickness="1"
                    TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
