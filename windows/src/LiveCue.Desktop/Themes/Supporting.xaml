<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Supporting elements (design system 4.23): tooltip, divider, scrollbar. -->

  <!--
    Tooltip: surface.inverse, radius.small, padding 8 / 6, type.caption in ink.onInverse. A tooltip is
    its own transparent window, where ClearType is not available, so greyscale is asked for
    explicitly (3.5, rule 9). The 500 ms delay is set once for the whole app in App.xaml.cs.
  -->
  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="VerticalOffset" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource InkOnInverseBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeCaptionSize}" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="{DynamicResource RadiusSmall}"
                  Background="{DynamicResource SurfaceInverseBrush}"
                  Padding="8,6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The scroller of a view that scrolls (Pairing at the minimum height, Settings). A ScrollViewer
    clips what it scrolls to its viewport, which would cut a panel's shadow off at the edge of the
    page. So the scroller reaches into the gaps around the page (InsetScrollerOutset) and the view
    puts the same distance back as the margin of its content (InsetScrollerContent). The scrollbar
    then sits in the window's own inset. Nothing translucent floats over what scrolls (rule W-1).

    Do not use ScrollViewer.Padding for this: it shrinks the clipping presenter instead of the content.
  -->
  <Thickness x:Key="InsetScrollerOutset">-16,-8,-16,-16</Thickness>
  <Thickness x:Key="InsetScrollerContent">16,8,16,16</Thickness>

  <Style x:Key="Page.Scroller" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="{StaticResource InsetScrollerOutset}" />
  </Style>

  <!-- Divider: stroke.hairline, 1 px. Decorative, carries no meaning. -->
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource StrokeHairlineBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Scrollbar: 12 wide gutter, no track fill, no arrow buttons; thumb 6 wide, radius 3. -->
  <Style x:Key="Scroll.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ControlScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- The transparent grid is the hit target; the visible thumb is the 6 px bar inside it. -->
          <Grid Background="Transparent">
            <Border x:Name="Bar" Margin="3" CornerRadius="3" Background="{TemplateBinding Background}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ControlScrollThumbHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ControlScrollThumbHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Scroll.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource Scroll.Thumb}" MinHeight="32" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource Scroll.Thumb}" MinWidth="32" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
