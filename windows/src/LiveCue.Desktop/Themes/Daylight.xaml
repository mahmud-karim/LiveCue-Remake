<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:theming="clr-namespace:LiveCue.Desktop.Theming"
                    mc:Ignorable="po">

  <!--
    Daylight: the one theme. Every colour, brush and shadow of the design system (docs/design/
    01-design-system.md, section 2) lives here and nowhere else, keyed by its token name:
    surface.panel is SurfacePanelBrush, shadow.raised is ShadowRaised, and so on.

    Rules for this file:
      - Styles reach these keys through DynamicResource, so HighContrast.xaml (same keys) can replace
        this dictionary while the app runs.
      - Alpha is written into the colour (#AARRGGBB); the comment gives the token's decimal alpha.
      - Everything is frozen, so one instance is shared by the whole app.
  -->

  <!-- 2.2 Ground -->
  <SolidColorBrush x:Key="GroundBaseBrush" Color="#E6ECF5" po:Freeze="True" />
  <Color x:Key="GroundBloom1Color">#9DC1F5</Color>
  <Color x:Key="GroundBloom2Color">#B9C4F7</Color>
  <Color x:Key="GroundBloom3Color">#A8D4F2</Color>
  <Color x:Key="GroundBloom4Color">#C7D3F5</Color>

  <!-- 2.3 Surfaces and elevation -->
  <SolidColorBrush x:Key="SurfacePanelBrush" Color="#9EFFFFFF" po:Freeze="True" />            <!-- white 0.62 -->
  <SolidColorBrush x:Key="SurfaceInsetBrush" Color="#75FFFFFF" po:Freeze="True" />            <!-- white 0.46 -->
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#D9FFFFFF" po:Freeze="True" />           <!-- white 0.85 -->
  <SolidColorBrush x:Key="SurfaceRaisedHoverBrush" Color="#FFFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceRaisedPressedBrush" Color="#FFEEF3FB" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#F7F9FBFF" po:Freeze="True" />          <!-- 0.97 -->
  <SolidColorBrush x:Key="SurfaceInverseBrush" Color="#E60E1B33" po:Freeze="True" />          <!-- ink 0.90 -->
  <SolidColorBrush x:Key="SurfaceScrimBrush" Color="#4D0E1B33" po:Freeze="True" />            <!-- ink 0.30 -->
  <SolidColorBrush x:Key="SurfaceQrBrush" Color="#FFFFFFFF" po:Freeze="True" />
  <!-- 4.15: the dark modules of the pairing code, 17.17:1 on surface.qr. -->
  <SolidColorBrush x:Key="QrModuleBrush" Color="#FF0E1B33" po:Freeze="True" />

  <!-- 2.3 State overlays -->
  <SolidColorBrush x:Key="StateHoverBrush" Color="#73FFFFFF" po:Freeze="True" />              <!-- white 0.45 -->
  <SolidColorBrush x:Key="StatePressedBrush" Color="#40FFFFFF" po:Freeze="True" />            <!-- white 0.25 -->
  <SolidColorBrush x:Key="StateHoverOnOverlayBrush" Color="#0F0E1B33" po:Freeze="True" />     <!-- ink 0.06 -->
  <SolidColorBrush x:Key="StatePressedOnOverlayBrush" Color="#1A0E1B33" po:Freeze="True" />   <!-- ink 0.10 -->
  <SolidColorBrush x:Key="StateCaptionHoverBrush" Color="#140E1B33" po:Freeze="True" />       <!-- ink 0.08 -->
  <SolidColorBrush x:Key="StateCaptionCloseHoverBrush" Color="#C42B1C" po:Freeze="True" />    <!-- 3.5 close hover -->

  <!-- 2.4 Strokes and sheen -->
  <LinearGradientBrush x:Key="StrokeEdgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#F2FFFFFF" />                                             <!-- white 0.95 -->
    <GradientStop Offset="1" Color="#99FFFFFF" />                                             <!-- white 0.60 -->
  </LinearGradientBrush>
  <SolidColorBrush x:Key="StrokeRaisedBrush" Color="#E6FFFFFF" po:Freeze="True" />            <!-- white 0.90 -->
  <SolidColorBrush x:Key="StrokeInsetBrush" Color="#B3FFFFFF" po:Freeze="True" />             <!-- white 0.70 -->
  <SolidColorBrush x:Key="StrokeOnAccentBrush" Color="#4DFFFFFF" po:Freeze="True" />          <!-- white 0.30 -->
  <SolidColorBrush x:Key="StrokeHairlineBrush" Color="#1F0E1B33" po:Freeze="True" />          <!-- ink 0.12 -->
  <SolidColorBrush x:Key="StrokeControlBrush" Color="#990E1B33" po:Freeze="True" />           <!-- ink 0.60 -->
  <SolidColorBrush x:Key="StrokeDangerBrush" Color="#59B3243F" po:Freeze="True" />            <!-- danger 0.35 -->
  <SolidColorBrush x:Key="StrokeFocusBrush" Color="#0B57D0" po:Freeze="True" />
  <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
    <GradientStop Offset="0" Color="#47FFFFFF" />                                             <!-- white 0.28 -->
    <GradientStop Offset="0.4" Color="#00FFFFFF" />
  </LinearGradientBrush>

  <!-- 2.5 Ink -->
  <SolidColorBrush x:Key="InkPrimaryBrush" Color="#0E1B33" po:Freeze="True" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="#3D4A63" po:Freeze="True" />
  <SolidColorBrush x:Key="InkDisabledBrush" Color="#610E1B33" po:Freeze="True" />             <!-- ink 0.38 -->
  <SolidColorBrush x:Key="InkOnAccentBrush" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="InkOnInverseBrush" Color="#FFFFFF" po:Freeze="True" />

  <!-- 2.6 Accent -->
  <SolidColorBrush x:Key="AccentFillBrush" Color="#0B57D0" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A66DE" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0949B0" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="#0842A0" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentTintBrush" Color="#1F0B57D0" po:Freeze="True" />              <!-- accent 0.12 -->
  <!--
    accent.fill when it colours text or a glyph on one of our surfaces rather than filling a shape.
    The same blue here; a separate key because contrast themes map the two uses to different
    system colours (Highlight for fills, HotTrack for text).
  -->
  <SolidColorBrush x:Key="AccentTextBrush" Color="#0B57D0" po:Freeze="True" />

  <!-- 2.7 Status colours. Every tint is alpha 0.12. -->
  <SolidColorBrush x:Key="StatusLiveBrush" Color="#0B57D0" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusLiveTintBrush" Color="#1F0B57D0" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0B6443" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusSuccessTintBrush" Color="#1F0B6443" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusWarningBrush" Color="#7D5108" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusWarningTintBrush" Color="#1F7D5108" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusDangerBrush" Color="#B3243F" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusDangerTintBrush" Color="#1FB3243F" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusDangerHoverBrush" Color="#BD2C47" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusDangerPressedBrush" Color="#9E1B34" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusOfflineBrush" Color="#3D4A63" po:Freeze="True" />
  <SolidColorBrush x:Key="StatusOfflineTintBrush" Color="#140E1B33" po:Freeze="True" />       <!-- ink 0.08 -->

  <!-- 2.8 Control tracks -->
  <SolidColorBrush x:Key="TrackProgressBrush" Color="#240E1B33" po:Freeze="True" />           <!-- ink 0.14 -->
  <SolidColorBrush x:Key="TrackSegmentedBrush" Color="#1A0E1B33" po:Freeze="True" />          <!-- ink 0.10 -->
  <SolidColorBrush x:Key="TrackToggleOffBrush" Color="#8C0E1B33" po:Freeze="True" />          <!-- ink 0.55 -->
  <SolidColorBrush x:Key="ControlKnobBrush" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="ControlScrollThumbBrush" Color="#400E1B33" po:Freeze="True" />      <!-- ink 0.25 -->
  <SolidColorBrush x:Key="ControlScrollThumbHoverBrush" Color="#660E1B33" po:Freeze="True" /> <!-- ink 0.40 -->
  <Color x:Key="ShadeColor">#283C6E</Color>

  <!-- 8.2 In-app brand mark below 64 px: flat accent bubble, white bars. -->
  <SolidColorBrush x:Key="BrandMarkBubbleBrush" Color="#0B57D0" po:Freeze="True" />
  <SolidColorBrush x:Key="BrandMarkBarsBrush" Color="#FFFFFF" po:Freeze="True" />

  <!-- 2.15 Opacity -->
  <sys:Double x:Key="OpacityDisabled">0.45</sys:Double>

  <!--
    2.13 Shadows. Opacity is the canonical alpha divided by the alpha of the fill that casts the
    shadow, so what shows outside the surface matches the token. Only "caster" layers carry these;
    nothing with text inside ever has an Effect (3.5, keeping text crisp).

    The colour goes through theming:ShadowColor because WPF reads a DropShadowEffect's colour as
    linear light; given the token as written it would draw a much darker, greyer shadow.
  -->
  <DropShadowEffect x:Key="ShadowPanel" Color="{theming:ShadowColor Token={StaticResource ShadeColor}}" Direction="270"
                    ShadowDepth="12" BlurRadius="32" Opacity="0.23" RenderingBias="Quality" po:Freeze="True" />
  <DropShadowEffect x:Key="ShadowRaised" Color="{theming:ShadowColor Token={StaticResource ShadeColor}}" Direction="270"
                    ShadowDepth="4" BlurRadius="12" Opacity="0.19" RenderingBias="Quality" po:Freeze="True" />
  <DropShadowEffect x:Key="ShadowOverlay" Color="{theming:ShadowColor Token={StaticResource ShadeColor}}" Direction="270"
                    ShadowDepth="24" BlurRadius="60" Opacity="0.23" RenderingBias="Quality" po:Freeze="True" />
  <DropShadowEffect x:Key="ShadowAccent" Color="{theming:ShadowColor Token={StaticResource ShadeColor}}" Direction="270"
                    ShadowDepth="6" BlurRadius="16" Opacity="0.28" RenderingBias="Quality" po:Freeze="True" />
  <DropShadowEffect x:Key="ShadowKnob" Color="{theming:ShadowColor Token=#0E1B33}" Direction="270"
                    ShadowDepth="2" BlurRadius="6" Opacity="0.30" RenderingBias="Quality" po:Freeze="True" />

</ResourceDictionary>
