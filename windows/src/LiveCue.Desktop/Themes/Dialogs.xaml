<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LiveCue.Desktop.Controls">

  <!--
    Dialog, banner and toast (design system 4.10 and 4.11). First versions with plain looks: every key
    exists and can be used by a page; the desktop core gives each its design-system appearance.

    The dialog card and the toast are opaque on purpose: they sit over other content, and rule W-1 of
    design system 3.5 forbids anything translucent there.
  -->

  <!-- The scrim over the whole window, sidebar included, while a dialog is open. -->
  <Style x:Key="Dialog.Scrim" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceScrimBrush}" />
  </Style>

  <!-- The dialog card. Shadow on the caster, content on the face, like every glass surface. -->
  <Style x:Key="Dialog.Card" TargetType="ContentControl">
    <Setter Property="Width" Value="440" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border CornerRadius="{DynamicResource RadiusPanel}"
                    Background="{DynamicResource SurfaceOverlayBrush}"
                    Effect="{DynamicResource ShadowOverlay}" />
            <Border CornerRadius="{DynamicResource RadiusPanel}"
                    BorderBrush="{DynamicResource StrokeEdgeBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toast: one short line at the bottom centre of the content area. -->
  <Style x:Key="Toast" TargetType="ContentControl">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Foreground" Value="{DynamicResource InkOnInverseBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border ui:Pill.IsPill="True"
                  Background="{DynamicResource SurfaceInverseBrush}"
                  Padding="{TemplateBinding Padding}"
                  TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Banner: a tinted strip with an optional title, a body and at most one quiet button. The tone picks the tint. -->
  <Style x:Key="Banner" TargetType="ui:Banner">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Body, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:Banner">
          <Grid>
            <Border CornerRadius="{DynamicResource RadiusField}" Background="{DynamicResource SurfaceRaisedBrush}" />
            <Border x:Name="Tint"
                    CornerRadius="{DynamicResource RadiusField}"
                    Background="{DynamicResource AccentTintBrush}"
                    Padding="{TemplateBinding Padding}">
              <DockPanel>
                <Button x:Name="Action"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource Button.Quiet}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding ActionLabel}"
                        Command="{TemplateBinding Command}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Style="{DynamicResource Type.Label}" />
                  <TextBlock Text="{TemplateBinding Body}"
                             Style="{DynamicResource Type.Body}"
                             TextWrapping="Wrap"
                             TextTrimming="None" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tone" Value="Success">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusSuccessTintBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusWarningTintBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
              <Setter TargetName="Tint" Property="Background" Value="{DynamicResource StatusDangerTintBrush}" />
            </Trigger>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActionLabel" Value="{x:Null}">
              <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ui:Banner" BasedOn="{StaticResource Banner}" />

</ResourceDictionary>
