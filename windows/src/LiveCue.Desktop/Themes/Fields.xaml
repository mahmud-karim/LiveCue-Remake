<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LiveCue.Desktop.Controls">

  <!--
    Fields and the segmented control (design system 4.4 and 4.6). The read-only field is the spike's.
    Field.Text and Segmented are first versions with plain looks; the desktop core gives each its
    design-system appearance.
  -->

  <!--
    Read-only field (design system 4.6): surface.inset fill, stroke.hairline outline, radius.field,
    at least 44 high. For values the user reads or copies, such as the PC address.
  -->
  <Style x:Key="Field.ReadOnly" TargetType="ContentControl">
    <Setter Property="MinHeight" Value="{DynamicResource FieldHeight}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="{DynamicResource RadiusField}"
                  Background="{DynamicResource SurfaceInsetBrush}"
                  BorderBrush="{DynamicResource StrokeHairlineBrush}"
                  BorderThickness="1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text field (design system 4.6). First version: the read-only field's face around an editable text box. -->
  <Style x:Key="Field.Text" TargetType="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource FieldHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InkPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Face"
                  CornerRadius="{DynamicResource RadiusField}"
                  Background="{DynamicResource SurfaceInsetBrush}"
                  BorderBrush="{DynamicResource StrokeControlBrush}"
                  BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource StrokeFocusBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control (design system 4.4). First version: a horizontal list on the segmented track; no travelling thumb yet. -->
  <Style x:Key="Segmented" TargetType="ui:SegmentedControl">
    <Setter Property="Background" Value="{DynamicResource TrackSegmentedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:SegmentedControl">
          <Border ui:Pill.IsPill="True" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ui:SegmentedControl" BasedOn="{StaticResource Segmented}" />

</ResourceDictionary>
