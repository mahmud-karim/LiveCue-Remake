<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:LiveCue.Desktop.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Interaction.xaml" />
    <ResourceDictionary Source="Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    List row (design system 4.8).

      [tile 32]  Title (type.body, ink.primary)              accessory  [chevron]
                 Subtitle (type.caption, ink.secondary)

    Rows are stacked in a panel padded with InsetPanelRows. Each row draws a stroke.hairline above
    itself, inset to the title's leading edge; set ShowSeparator="False" on the first row of a group. One line is at least 48 high, two lines at least 60. Hover and pressed
    exist only on rows marked IsInteractive, and only ever lighten.
  -->

  <Style TargetType="ui:ListRow">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Row}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="{DynamicResource RowHeightTwoLine}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
    <Setter Property="FontSize" Value="{DynamicResource TypeBodySize}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:ListRow">
          <Grid Background="Transparent">
            <Border x:Name="HoverFill"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Background="{DynamicResource StateHoverBrush}"
                    Opacity="0" />
            <Border x:Name="PressedFill"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Background="{DynamicResource StatePressedBrush}"
                    Visibility="Collapsed" />
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border x:Name="Tile"
                      Width="{DynamicResource RowTileSize}"
                      Height="{DynamicResource RowTileSize}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      CornerRadius="{DynamicResource RadiusTileSmall}"
                      Background="{DynamicResource AccentTintBrush}"
                      TextElement.Foreground="{DynamicResource AccentTextBrush}">
                <ui:Icon Glyph="{TemplateBinding Glyph}"
                         Width="{DynamicResource IconSizeSmall}"
                         Height="{DynamicResource IconSizeSmall}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10">
                <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource Type.Body}" />
                <TextBlock x:Name="Subtitle"
                           Text="{TemplateBinding Subtitle}"
                           Style="{DynamicResource Type.Caption}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{DynamicResource InkSecondaryBrush}" />
              </StackPanel>

              <ContentPresenter Grid.Column="2"
                                Margin="12,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource InkSecondaryBrush}" />

              <ui:Icon x:Name="Chevron"
                       Grid.Column="3"
                       Glyph="{StaticResource Icon.ChevronRight}"
                       Width="{DynamicResource IconSizeSmall}"
                       Height="{DynamicResource IconSizeSmall}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource InkSecondaryBrush}"
                       Visibility="Collapsed" />
            </Grid>

            <Border x:Name="Separator"
                    Height="1"
                    Margin="60,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource StrokeHairlineBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Glyph" Value="{x:Null}">
              <Setter TargetName="Tile" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Separator" Property="Margin" Value="16,0,16,0" />
            </Trigger>
            <Trigger Property="Tone" Value="Neutral">
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource StatusOfflineTintBrush}" />
              <Setter TargetName="Tile" Property="TextElement.Foreground" Value="{DynamicResource InkSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Subtitle" Value="">
              <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowSeparator" Value="False">
              <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowChevron" Value="True">
              <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsInteractive" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <MultiTrigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource Motion.HoverIn}" />
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource Motion.HoverOut}" />
              </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsInteractive" Value="True" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PressedFill" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsInteractive" Value="True">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
      </Trigger>
      <Trigger Property="Subtitle" Value="">
        <Setter Property="MinHeight" Value="{DynamicResource RowHeightOneLine}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
