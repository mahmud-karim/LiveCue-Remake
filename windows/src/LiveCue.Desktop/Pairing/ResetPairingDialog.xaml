<UserControl x:Class="LiveCue.Desktop.Pairing.ResetPairingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LiveCue.Desktop"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             Focusable="False"
             AutomationProperties.AutomationId="{x:Static app:AutomationIds.ResetPairingDialog}">

  <!--
    The reset confirmation (docs/design/03-windows-screens.md, 6.1). Cancel comes first and is the
    default; the confirm button is the destructive one and Enter does not press it. First version: the
    texts, the failure banner and the two buttons; initial focus arrives with the dialog host.
  -->
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{DynamicResource Type.Title}" />
    <TextBlock Text="{Binding Body}"
               Style="{DynamicResource Type.Body}"
               TextWrapping="Wrap"
               TextTrimming="None"
               Margin="0,8,0,0" />
    <ui:Banner Model="{Binding Failure}" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Style="{DynamicResource Button.Secondary}"
              Content="Cancel"
              IsCancel="True"
              Command="{Binding CancelCommand}" />
      <Button Style="{DynamicResource Button.DestructivePrimary}"
              Margin="8,0,0,0"
              Content="Reset pairing"
              Command="{Binding ConfirmCommand}"
              AutomationProperties.AutomationId="{x:Static app:AutomationIds.ConfirmResetPairingButton}" />
    </StackPanel>
  </StackPanel>
</UserControl>
