<UserControl x:Class="LiveCue.Desktop.Live.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LiveCue.Desktop"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             Focusable="False">

  <!--
    Live (docs/design/03-windows-screens.md, section 2; mockups win-live-stopped and win-live-ready).
    The layout is the spike's. First version: the relay controls, the two statuses and the PC address
    are bound; the transcript and the reply show their initial texts. The prerequisite list, the
    banners and the reply lists arrive with the page (W-design 5.5).
  -->
  <DockPanel>

    <!-- Page header: the view's name, and the relay controls on the right. -->
    <Grid DockPanel.Dock="Top" MinHeight="{DynamicResource SizePageHeader}" Margin="4,0,4,16">
      <TextBlock Text="Live" Style="{DynamicResource Type.Display}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <!-- Not running: Start is the only accent control on the page. -->
        <Button Style="{DynamicResource Button.Primary.Session}"
                ui:ButtonAssist.Icon="{StaticResource Icon.Play}"
                Content="{Binding StartLabel}"
                Command="{Binding StartRelayCommand}"
                Visibility="{Binding IsStartVisible, Converter={StaticResource BooleanToVisibility}}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.StartRelayButton}" />
        <!-- Running: no accent control at all; nothing here needs pressing. -->
        <Button Style="{DynamicResource Button.Secondary}"
                ui:ButtonAssist.Icon="{StaticResource Icon.Pause}"
                Content="{Binding PauseResumeLabel}"
                Command="{Binding PauseResumeCommand}"
                Visibility="{Binding AreRunningControlsVisible, Converter={StaticResource BooleanToVisibility}}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.PauseRelayButton}" />
        <Button Style="{DynamicResource Button.Secondary}"
                Margin="8,0,0,0"
                ui:ButtonAssist.Icon="{StaticResource Icon.Stop}"
                ui:ButtonAssist.IconBrush="{DynamicResource StatusDangerBrush}"
                Content="Stop relay"
                Command="{Binding StopRelayCommand}"
                Visibility="{Binding AreRunningControlsVisible, Converter={StaticResource BooleanToVisibility}}"
                AutomationProperties.AutomationId="{x:Static app:AutomationIds.StopRelayButton}" />
      </StackPanel>
    </Grid>

    <!-- Status strip: relay status, iPhone status, PC address. -->
    <ContentControl x:Name="StatusStrip"
                    DockPanel.Dock="Top"
                    Style="{DynamicResource Glass.PanelCompact}"
                    Margin="0,0,0,16">
      <ui:SplitRowPanel>
        <StackPanel Orientation="Horizontal">
          <StackPanel MaxWidth="440">
            <TextBlock Text="Relay" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource InkSecondaryBrush}" />
            <ui:StatusIndicatorView Indicator="{Binding RelayStatus}"
                                    Margin="0,4,0,0"
                                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.RelayStatusText}" />
          </StackPanel>
          <StackPanel Margin="32,0,0,0">
            <TextBlock Text="iPhone" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource InkSecondaryBrush}" />
            <ui:StatusIndicatorView Indicator="{Binding PhoneStatus}"
                                    Margin="0,4,0,0"
                                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.PhoneStatusText}" />
          </StackPanel>
        </StackPanel>

        <StackPanel>
          <TextBlock Text="PC address" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource InkSecondaryBrush}" />
          <TextBlock Text="{Binding PcAddress}"
                     Margin="0,5,0,1"
                     AutomationProperties.AutomationId="{x:Static app:AutomationIds.PcAddressText}">
            <TextBlock.Style>
              <!-- Until the relay has run once, the placeholder is quieter than a real address. -->
              <Style TargetType="TextBlock" BasedOn="{StaticResource Type.Mono}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPcAddress}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ui:SplitRowPanel>
    </ContentControl>

    <!-- Two panels side by side, 0.88 : 1.12. Each has one inset card that takes the remaining height. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.88*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.12*" />
      </Grid.ColumnDefinitions>

      <ContentControl x:Name="TranscriptPanel" Style="{DynamicResource Glass.Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Incoming transcript" Style="{DynamicResource Type.Headline}" />
          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Margin="0,4,0,0"
                      TextElement.Foreground="{DynamicResource InkSecondaryBrush}">
            <ui:Icon Glyph="{StaticResource Icon.Mic}"
                     Width="{DynamicResource IconSizeSmall}"
                     Height="{DynamicResource IconSizeSmall}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding TranscriptHint}"
                       Style="{DynamicResource Type.Caption}"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.TranscriptHint}" />
          </StackPanel>
          <ContentControl Style="{DynamicResource Glass.Card}" Margin="0,12,0,0" VerticalContentAlignment="Top" MinHeight="120">
            <StackPanel>
              <TextBlock Text="From iPhone" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource InkSecondaryBrush}" />
              <TextBlock Text="{Binding TranscriptText}"
                         Style="{DynamicResource Type.Transcript}"
                         Foreground="{DynamicResource InkSecondaryBrush}"
                         MaxWidth="{DynamicResource SizeReadingMax}"
                         HorizontalAlignment="Left"
                         Margin="0,8,0,0"
                         AutomationProperties.AutomationId="{x:Static app:AutomationIds.TranscriptText}" />
            </StackPanel>
          </ContentControl>
        </DockPanel>
      </ContentControl>

      <ContentControl Grid.Column="2" Style="{DynamicResource Glass.Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Assistant reply" Style="{DynamicResource Type.Headline}" />
          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Margin="0,4,0,0"
                      TextElement.Foreground="{DynamicResource InkSecondaryBrush}">
            <ui:Icon Glyph="{StaticResource Icon.Sparkles}"
                     Width="{DynamicResource IconSizeSmall}"
                     Height="{DynamicResource IconSizeSmall}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding ReplyHint}"
                       Style="{DynamicResource Type.Caption}"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReplyHint}" />
          </StackPanel>
          <ContentControl Style="{DynamicResource Glass.Card}" Margin="0,12,0,0" VerticalContentAlignment="Top" MinHeight="120">
            <StackPanel>
              <TextBlock Text="Assistant" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource AccentTextBrush}" />
              <TextBlock Text="{Binding ReplyText}"
                         Style="{DynamicResource Type.Cue}"
                         Foreground="{DynamicResource InkSecondaryBrush}"
                         MaxWidth="{DynamicResource SizeReadingMax}"
                         HorizontalAlignment="Left"
                         Margin="0,8,0,0"
                         AutomationProperties.AutomationId="{x:Static app:AutomationIds.ReplyText}" />
            </StackPanel>
          </ContentControl>
        </DockPanel>
      </ContentControl>
    </Grid>
  </DockPanel>
</UserControl>
