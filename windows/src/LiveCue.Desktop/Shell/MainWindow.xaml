<Window x:Class="LiveCue.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:LiveCue.Desktop"
        xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
        Title="LiveCue"
        Width="1240"
        Height="660"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/LiveCue.ico"
        Background="{DynamicResource GroundBaseBrush}"
        Foreground="{DynamicResource InkPrimaryBrush}"
        FontFamily="{DynamicResource FontFamilyText}"
        FontSize="{DynamicResource TypeBodySize}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">

  <!--
    The window is opaque and paints its own ground: no Mica, no Acrylic, no AllowsTransparency. An
    opaque window is what keeps ClearType working (design system 3.5). A glass frame thickness of 1
    keeps the system window shadow, the rounded corners and the resize behaviour.
    CaptionHeight matches SizeTitleBar.
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="1"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <!-- Ctrl+1 to Ctrl+4 choose a view; Escape cancels the open dialog (W-design 5.2). -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static app:AppPage.Live}" />
    <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static app:AppPage.Pairing}" />
    <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static app:AppPage.Activity}" />
    <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static app:AppPage.Settings}" />
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </Window.InputBindings>

  <Grid x:Name="Root">

    <!-- Ground: base colour and the four blooms, under everything including the title bar. -->
    <ui:BloomLayer Base="{DynamicResource GroundBaseBrush}"
                   Bloom1="{DynamicResource GroundBloom1Color}"
                   Bloom2="{DynamicResource GroundBloom2Color}"
                   Bloom3="{DynamicResource GroundBloom3Color}"
                   Bloom4="{DynamicResource GroundBloom4Color}" />

    <!-- Everything else. When the window is maximised this grid is inset by the part that overhangs the screen. -->
    <Grid x:Name="Frame">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar: part of the ground, no fill of its own. The whole strip is the drag region. -->
      <Grid Grid.Row="0" Height="{DynamicResource SizeTitleBar}">
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <ui:BrandMark Height="20"
                        VerticalAlignment="Center"
                        Bubble="{DynamicResource BrandMarkBubbleBrush}"
                        Bars="{DynamicResource BrandMarkBarsBrush}" />
          <TextBlock Text="LiveCue" Margin="8,0,0,0" Style="{DynamicResource Chrome.Wordmark}" />
        </StackPanel>

        <ContentControl Style="{DynamicResource Chrome.CaptionCapsule}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <Button Style="{DynamicResource Chrome.CaptionButton}"
                    ui:ButtonAssist.Icon="{StaticResource Icon.Caption.Minimize}"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    ToolTip="Minimize"
                    AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton"
                    Style="{DynamicResource Chrome.CaptionButton}"
                    ui:ButtonAssist.Icon="{StaticResource Icon.Caption.Maximize}"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    ToolTip="Maximize"
                    AutomationProperties.Name="Maximize" />
            <Button x:Name="RestoreButton"
                    Style="{DynamicResource Chrome.CaptionButton}"
                    ui:ButtonAssist.Icon="{StaticResource Icon.Caption.Restore}"
                    Command="{x:Static SystemCommands.RestoreWindowCommand}"
                    ToolTip="Restore"
                    AutomationProperties.Name="Restore"
                    Visibility="Collapsed" />
            <Button Style="{DynamicResource Chrome.CaptionButton.Close}"
                    ui:ButtonAssist.Icon="{StaticResource Icon.Caption.Close}"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    ToolTip="Close"
                    AutomationProperties.Name="Close" />
          </StackPanel>
        </ContentControl>
      </Grid>

      <!--
        Below the title bar (docs/design/03-windows-screens.md, 1.3 and 1.4): the sidebar, 16, then the
        page. The page fills its area and decides its own scrolling, because some views fill the
        height (Live, Activity) and others scroll (Pairing at the minimum height, Settings).
      -->
      <Grid Grid.Row="1" Margin="16,0,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: a glass panel with the four navigation rows and, at its foot, the status card. -->
        <ContentControl x:Name="Sidebar"
                        Style="{DynamicResource Glass.Panel}"
                        Padding="{DynamicResource InsetSidebar}"
                        Width="{DynamicResource SizeSidebar}">
          <DockPanel>
            <!-- Always visible, and not a button: relay, iPhone, and what closing the window does. -->
            <ContentControl DockPanel.Dock="Bottom"
                            Style="{DynamicResource Glass.Card}"
                            ui:Glass.CornerRadius="{DynamicResource RadiusCardInSidebar}"
                            Padding="14">
              <StackPanel>
                <TextBlock Text="Relay"
                           Style="{DynamicResource Type.Micro}"
                           Foreground="{DynamicResource InkSecondaryBrush}" />
                <ui:StatusIndicatorView Indicator="{Binding SidebarRelayStatus}"
                                        Margin="0,4,0,0"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.SidebarRelayStatus}" />
                <TextBlock Text="iPhone"
                           Style="{DynamicResource Type.Micro}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           Margin="0,12,0,0" />
                <ui:StatusIndicatorView Indicator="{Binding SidebarPhoneStatus}"
                                        Margin="0,4,0,0"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.SidebarPhoneStatus}" />
                <TextBlock Text="Closing this window stops the relay."
                           Style="{DynamicResource Type.Caption}"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Margin="0,12,0,0" />
              </StackPanel>
            </ContentControl>

            <!-- One row is always selected; Up and Down move the selection. The tag of a row is its page. -->
            <ListBox x:Name="Navigation"
                     Style="{DynamicResource Nav.List}"
                     ItemContainerStyle="{DynamicResource Nav.Item}"
                     SelectedValuePath="Tag"
                     SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                     AutomationProperties.Name="Views">
              <ListBoxItem Tag="{x:Static app:AppPage.Live}"
                           AutomationProperties.AutomationId="{x:Static app:AutomationIds.NavLive}"
                           AutomationProperties.Name="Live">
                <StackPanel Orientation="Horizontal">
                  <ui:Icon Glyph="{StaticResource Icon.Wave}"
                           Width="{DynamicResource IconSizeRegular}"
                           Height="{DynamicResource IconSizeRegular}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                  <TextBlock Text="Live"
                             VerticalAlignment="Center"
                             LineHeight="{DynamicResource TypeBodyLineHeight}"
                             LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="{x:Static app:AppPage.Pairing}"
                           AutomationProperties.AutomationId="{x:Static app:AutomationIds.NavPairing}"
                           AutomationProperties.Name="Pairing">
                <StackPanel Orientation="Horizontal">
                  <ui:Icon Glyph="{StaticResource Icon.Qr}"
                           Width="{DynamicResource IconSizeRegular}"
                           Height="{DynamicResource IconSizeRegular}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                  <TextBlock Text="Pairing"
                             VerticalAlignment="Center"
                             LineHeight="{DynamicResource TypeBodyLineHeight}"
                             LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="{x:Static app:AppPage.Activity}"
                           AutomationProperties.AutomationId="{x:Static app:AutomationIds.NavActivity}"
                           AutomationProperties.Name="Activity">
                <StackPanel Orientation="Horizontal">
                  <ui:Icon Glyph="{StaticResource Icon.Activity}"
                           Width="{DynamicResource IconSizeRegular}"
                           Height="{DynamicResource IconSizeRegular}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                  <TextBlock Text="Activity"
                             VerticalAlignment="Center"
                             LineHeight="{DynamicResource TypeBodyLineHeight}"
                             LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="{x:Static app:AppPage.Settings}"
                           AutomationProperties.AutomationId="{x:Static app:AutomationIds.NavSettings}"
                           AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal">
                  <ui:Icon Glyph="{StaticResource Icon.Settings}"
                           Width="{DynamicResource IconSizeRegular}"
                           Height="{DynamicResource IconSizeRegular}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                  <TextBlock Text="Settings"
                             VerticalAlignment="Center"
                             LineHeight="{DynamicResource TypeBodyLineHeight}"
                             LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </DockPanel>
        </ContentControl>

        <!-- The selected view. Shell/PageTemplates.xaml picks the view for the view model's type. -->
        <ContentControl x:Name="PageHost"
                        Grid.Column="2"
                        Content="{Binding CurrentPage}"
                        Focusable="False"
                        IsTabStop="False" />

        <!-- Toast layer: one line at the bottom centre of the content area (design system 4.11). -->
        <ContentControl x:Name="ToastLayer"
                        Grid.Column="2"
                        Style="{DynamicResource Toast}"
                        Margin="0,0,0,8"
                        Visibility="{Binding ToastText, Converter={StaticResource NullToVisibility}}">
          <TextBlock Text="{Binding ToastText}" Style="{DynamicResource Type.Label}" Foreground="{DynamicResource InkOnInverseBrush}" />
        </ContentControl>
      </Grid>
    </Grid>

    <!-- Dialog layer: a scrim over the whole window, sidebar included, and the dialog card (design system 4.10). -->
    <Grid x:Name="DialogLayer" Visibility="{Binding ActiveDialog, Converter={StaticResource NullToVisibility}}">
      <Border Style="{DynamicResource Dialog.Scrim}" />
      <ContentControl Style="{DynamicResource Dialog.Card}" Content="{Binding ActiveDialog}" />
    </Grid>
  </Grid>
</Window>
