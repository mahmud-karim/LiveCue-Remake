<UserControl x:Class="LiveCue.Desktop.Views.PairingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             Focusable="False">

  <!--
    Pairing (docs/design/03-windows-screens.md, section 3; mockup win-pairing-shown). The layout is
    the design's: the QR panel, the panel beside it, and the separate reset panel. Pairing itself is
    not built yet, so the tile shows its placeholder and the reset stays disabled.
  -->
  <DockPanel>

    <Grid DockPanel.Dock="Top" MinHeight="{DynamicResource SizePageHeader}" Margin="4,0,4,16">
      <TextBlock Text="{Binding Title}" Style="{DynamicResource Type.Display}" VerticalAlignment="Center" />
    </Grid>

    <!-- At the minimum height the page scrolls rather than squeeze the tile or the reset panel. -->
    <ScrollViewer Style="{DynamicResource Page.Scroller}">
      <StackPanel Margin="{DynamicResource InsetScrollerContent}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Left panel: the QR tile. Always opaque white with nothing on top, or the code stops scanning (4.15). -->
          <ContentControl Style="{DynamicResource Glass.Panel}" Width="{DynamicResource SizeQrPanel}">
            <Grid Height="264" AutomationProperties.AutomationId="PairingQr" AutomationProperties.Name="Pairing QR code, hidden">
              <Border CornerRadius="{DynamicResource RadiusCard}"
                      Background="{DynamicResource SurfaceQrBrush}"
                      Effect="{DynamicResource ShadowRaised}" />
              <Border CornerRadius="{DynamicResource RadiusCard}"
                      BorderBrush="{DynamicResource StrokeRaisedBrush}"
                      BorderThickness="1"
                      Padding="12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="64"
                          Height="64"
                          CornerRadius="{DynamicResource RadiusCard}"
                          Background="{DynamicResource AccentTintBrush}"
                          HorizontalAlignment="Center">
                    <ui:Icon Glyph="{StaticResource Icon.Qr}"
                             Width="28"
                             Height="28"
                             Foreground="{DynamicResource AccentTextBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Your pairing code"
                             Style="{DynamicResource Type.Headline}"
                             HorizontalAlignment="Center"
                             Margin="0,12,0,0" />
                  <TextBlock Text="{Binding TileCaption}"
                             Style="{DynamicResource Type.Caption}"
                             Foreground="{DynamicResource InkSecondaryBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </ContentControl>

          <!-- Right panel: title, hint, buttons, PC address, footnote. -->
          <ContentControl Grid.Column="2" Style="{DynamicResource Glass.Panel}">
            <StackPanel>
              <TextBlock Text="Pair your iPhone" Style="{DynamicResource Type.Title}" />
              <TextBlock Text="{Binding Hint}"
                         Style="{DynamicResource Type.Body}"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         MaxWidth="{DynamicResource SizeReadingMax}"
                         HorizontalAlignment="Left"
                         Margin="0,8,0,0"
                         AutomationProperties.AutomationId="PairingHint" />

              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{DynamicResource Button.Primary}"
                        ui:ButtonAssist.Icon="{StaticResource Icon.Qr}"
                        Content="Show QR"
                        Command="{Binding ShowQrCommand}"
                        AutomationProperties.AutomationId="ShowQrButton" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Margin="8,0,0,0"
                        Content="Hide QR"
                        Command="{Binding HideQrCommand}"
                        AutomationProperties.AutomationId="HideQrButton" />
              </StackPanel>
              <!-- Why Show QR is disabled, when it is. The line keeps its height when empty, so nothing below moves. -->
              <TextBlock Text="{Binding ShowQrCaption}"
                         Style="{DynamicResource Type.Caption}"
                         Foreground="{DynamicResource InkSecondaryBrush}"
                         Margin="2,6,0,0" />

              <TextBlock Text="PC address"
                         Style="{DynamicResource Type.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource InkSecondaryBrush}"
                         Margin="2,10,0,6" />
              <ContentControl Style="{DynamicResource Field.ReadOnly}" AutomationProperties.AutomationId="PairingAddressField">
                <TextBlock Text="{Binding Relay.PcAddressText}" Style="{DynamicResource Type.Mono}" />
              </ContentControl>

              <TextBlock Text="Pairing codes are private. Codes hide after 2 minutes. Showing the QR again keeps existing pairings valid."
                         Style="{DynamicResource Type.Caption}"
                         Foreground="{DynamicResource InkSecondaryBrush}"
                         TextWrapping="Wrap"
                         TextTrimming="None"
                         Margin="0,12,0,0" />
            </StackPanel>
          </ContentControl>
        </Grid>

        <!-- Reset pairing: a separate panel, so it cannot be mistaken for part of normal pairing. -->
        <ContentControl Style="{DynamicResource Glass.Panel.Compact}" Padding="20,16" Margin="0,16,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{DynamicResource Button.Destructive}"
                    Margin="16,0,0,0"
                    Content="Reset pairing…"
                    Command="{Binding ResetPairingCommand}"
                    AutomationProperties.AutomationId="ResetPairingButton" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Reset pairing" Style="{DynamicResource Type.Headline}" />
              <TextBlock Text="Creates a new pairing code. Every iPhone paired with this PC stops working until it scans the new QR."
                         Style="{DynamicResource Type.Caption}"
                         Foreground="{DynamicResource InkSecondaryBrush}"
                         TextWrapping="Wrap"
                         TextTrimming="None" />
            </StackPanel>
          </DockPanel>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
