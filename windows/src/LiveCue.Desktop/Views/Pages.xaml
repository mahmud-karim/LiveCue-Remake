<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:LiveCue.Desktop.ViewModels"
                    xmlns:views="clr-namespace:LiveCue.Desktop.Views">

  <!-- Which view shows which page view model. The window's page host picks by type. -->

  <DataTemplate DataType="{x:Type vm:LivePageViewModel}">
    <views:LivePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:PairingPageViewModel}">
    <views:PairingPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ActivityPageViewModel}">
    <views:ActivityPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
    <views:SettingsPage />
  </DataTemplate>

</ResourceDictionary>
