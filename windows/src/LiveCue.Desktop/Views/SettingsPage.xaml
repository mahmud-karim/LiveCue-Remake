<UserControl x:Class="LiveCue.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             Focusable="False">

  <!--
    Settings (docs/design/03-windows-screens.md, section 5): one scrolling page of panels. The spike
    shows what settings.json holds, read-only, as rows: the Connection panel with its chip, and About.
    The editable controls, the Tailscale mapping, Assistant and PC speech models arrive with their features.
  -->
  <DockPanel>

    <Grid DockPanel.Dock="Top" MinHeight="{DynamicResource SizePageHeader}" Margin="4,0,4,16">
      <TextBlock Text="{Binding Title}" Style="{DynamicResource Type.Display}" VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer Style="{DynamicResource Page.Scroller}">
      <StackPanel Margin="{DynamicResource InsetScrollerContent}">

        <ContentControl Style="{DynamicResource Glass.Panel}" Padding="{DynamicResource InsetPanelRows}">
          <StackPanel>
            <Grid Margin="16,10,12,6">
              <TextBlock Text="Connection" Style="{DynamicResource Type.Headline}" VerticalAlignment="Center" />
              <ui:StatusChip HorizontalAlignment="Right" Kind="Neutral" Text="Applies the next time the relay starts" />
            </Grid>

            <ui:ListRow Glyph="{StaticResource Icon.Link}"
                        Title="Mode"
                        Subtitle="{Binding ModeExplanation}"
                        Content="{Binding ModeText}"
                        ShowSeparator="False"
                        AutomationProperties.AutomationId="ConnectionModeSelector" />

            <ui:ListRow Glyph="{StaticResource Icon.Monitor}"
                        Tone="Neutral"
                        Title="HTTPS port"
                        Subtitle="The port of the PC address your iPhone uses"
                        AutomationProperties.AutomationId="HttpsPortField">
              <TextBlock Text="{Binding HttpsPortText}" Typography.NumeralAlignment="Tabular" />
            </ui:ListRow>

            <ui:ListRow Glyph="{StaticResource Icon.Monitor}"
                        Tone="Neutral"
                        Title="Relay port"
                        Subtitle="On this PC only. Nothing outside this PC can reach it directly.">
              <TextBlock Text="{Binding RelayPortText}" Typography.NumeralAlignment="Tabular" />
            </ui:ListRow>
          </StackPanel>
        </ContentControl>

        <ContentControl Style="{DynamicResource Glass.Panel}" Padding="{DynamicResource InsetPanelRows}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="About" Style="{DynamicResource Type.Headline}" Margin="16,12,16,6" />

            <ui:ListRow Glyph="{StaticResource Icon.Info}"
                        Tone="Neutral"
                        Title="Version"
                        Subtitle="{Binding ProtocolText, StringFormat='Relay protocol {0}'}"
                        ShowSeparator="False">
              <TextBlock Text="{Binding VersionText}" Typography.NumeralAlignment="Tabular" />
            </ui:ListRow>

            <ui:ListRow Glyph="{StaticResource Icon.Check}"
                        Tone="Neutral"
                        Title="Licence"
                        Content="{Binding LicenceText}" />
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
