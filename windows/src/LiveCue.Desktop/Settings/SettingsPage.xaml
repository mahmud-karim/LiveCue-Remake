<UserControl x:Class="LiveCue.Desktop.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:app="clr-namespace:LiveCue.Desktop"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             xmlns:relay="clr-namespace:LiveCue.Relay;assembly=LiveCue.Relay"
             xmlns:hosting="clr-namespace:LiveCue.Hosting;assembly=LiveCue.Hosting"
             Focusable="False">

  <!--
    Settings (docs/design/03-windows-screens.md, section 5; mockups win-settings-connection and
    win-settings-assistant; W-design 5.8). One page that always scrolls:

      Connection        the form on the left (mode, ports, path, the resulting PC address, Save and
                        Discard) and, on the right, the Tailscale mapping of the mode that is saved:
                        its state, the exact command "Set up connection…" would run and what it
                        changes, and a warning for every other mapping that forwards to the relay
      Assistant         the Codex path, and what the last check found: Codex, sign-in, version
      PC speech models  the lab folder, the folder in use, the model the relay last reported
      Privacy switch    hide this window from screen capture
      About             version, licence, notices, source

    The form is saved only by "Save", and saving changes nothing in Tailscale. Nothing on this page
    runs a Tailscale command: the two buttons that can lead to one open the dialog that shows it, and
    a mapping LiveCue did not create has its removal command as text and no button at all.
    The two columns of Connection stack below a window width of 1100, and so do the two panels under it.
  -->

  <UserControl.Resources>

    <!-- The label above a field: always visible, never a placeholder (design system 4.6). -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Type.Caption}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
      <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <!-- A supporting line: type.caption in the quieter ink, wrapping. -->
    <Style x:Key="Helper" TargetType="TextBlock" BasedOn="{StaticResource Type.Caption}">
      <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- The error line under a field: the alert glyph and the reason, in status.danger (design system 4.6). -->
    <DataTemplate x:Key="FieldError">
      <DockPanel Margin="2,6,0,0" TextElement.Foreground="{DynamicResource StatusDangerBrush}">
        <ui:Icon DockPanel.Dock="Left"
                 Glyph="{StaticResource Icon.Alert}"
                 Width="14"
                 Height="14"
                 Margin="0,2,6,0"
                 VerticalAlignment="Top" />
        <TextBlock Text="{Binding}"
                   Style="{StaticResource Type.Caption}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </DataTemplate>

    <!-- A command shown as text for the owner to select and copy. Read-only: nothing here runs it. -->
    <Style x:Key="CommandField" TargetType="TextBox" BasedOn="{StaticResource Field.Text}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="False" />
      <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeMonoSize}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
  </UserControl.Resources>

  <ui:PageLayout Title="Settings">

    <!--
      The bar's 12 are always kept free in the window's own inset (16 - 12 = 4 at the right), so the
      panels are as wide as on every other page.
    -->
    <ScrollViewer x:Name="PageScroller" Style="{DynamicResource Page.Scroller}" VerticalScrollBarVisibility="Visible">
      <StackPanel Margin="16,8,4,16">

        <!-- ================================ Connection ================================ -->
        <ContentControl x:Name="ConnectionPanel" Style="{DynamicResource Glass.Panel}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Connection"
                         Style="{DynamicResource Type.Headline}"
                         VerticalAlignment="Center"
                         AutomationProperties.HeadingLevel="Level2" />
              <!-- When a saved change takes effect: a neutral chip with the information glyph. -->
              <Grid Grid.Column="1" MinHeight="{DynamicResource ChipHeight}" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border ui:Pill.IsPill="True" Background="{DynamicResource SurfaceRaisedBrush}" />
                <Border ui:Pill.IsPill="True"
                        Background="{DynamicResource StatusOfflineTintBrush}"
                        Padding="{DynamicResource ChipPadding}"
                        TextElement.Foreground="{DynamicResource StatusOfflineBrush}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Icon Glyph="{StaticResource Icon.Info}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Applies the next time the relay starts"
                               Style="{DynamicResource Type.Caption}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- The settings file could not be read; the running relay still uses the previous settings. -->
            <ui:Banner Model="{Binding SettingsFileNotice}"
                       Margin="0,12,0,0"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.SettingsFileNotice}" />
            <ui:Banner Model="{Binding RestartNotice}"
                       Margin="0,12,0,0"
                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.RestartNotice}" />

            <ui:TwoColumnPanel x:Name="ConnectionColumns" Gap="24" StackBelow="780" Margin="0,12,0,0">

              <!-- Left column: the form. -->
              <StackPanel x:Name="ConnectionForm">
                <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                <ui:SegmentedControl HorizontalAlignment="Stretch"
                                     SelectedValuePath="Tag"
                                     SelectedValue="{Binding Mode}"
                                     AutomationProperties.Name="Mode"
                                     AutomationProperties.AutomationId="{x:Static app:AutomationIds.ConnectionModeSelector}">
                  <ListBoxItem Content="Private tailnet" Tag="{x:Static relay:ConnectionMode.Private}" />
                  <ListBoxItem Content="Public Funnel" Tag="{x:Static relay:ConnectionMode.Public}" />
                </ui:SegmentedControl>
                <TextBlock Text="{Binding ModeExplanation}" Style="{StaticResource Helper}" Margin="0,8,0,0" />

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel>
                    <TextBlock Text="Relay port" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{DynamicResource Field.Text}"
                             Text="{Binding RelayPortText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="5"
                             AutomationProperties.Name="Relay port"
                             AutomationProperties.HelpText="The port the relay listens on, on this PC only."
                             AutomationProperties.AutomationId="{x:Static app:AutomationIds.RelayPortField}" />
                  </StackPanel>

                  <!-- Private tailnet: a tailnet-only HTTPS listener of its own, at the root path. -->
                  <StackPanel Grid.Column="2"
                              Visibility="{Binding IsPublicMode, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="HTTPS port" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{DynamicResource Field.Text}"
                             Text="{Binding PrivateHttpsPortText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="5"
                             AutomationProperties.Name="HTTPS port"
                             AutomationProperties.AutomationId="{x:Static app:AutomationIds.PrivateHttpsPortField}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4"
                              Visibility="{Binding IsPublicMode, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="Path" Style="{StaticResource FieldLabel}" />
                    <ContentControl Style="{DynamicResource Field.ReadOnly}" AutomationProperties.Name="Path">
                      <TextBlock Text="/" Style="{DynamicResource Type.Body}" />
                    </ContentControl>
                  </StackPanel>

                  <!-- Public Funnel: Tailscale mounts the relay under this path and removes it before forwarding. -->
                  <StackPanel Grid.Column="2"
                              Grid.ColumnSpan="3"
                              Visibility="{Binding IsPublicMode, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="Path" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{DynamicResource Field.Text}"
                             Text="{Binding PublicPathPrefix, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="64"
                             AutomationProperties.Name="Path"
                             AutomationProperties.AutomationId="{x:Static app:AutomationIds.PublicPathPrefixField}" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="The port the relay listens on, on this PC only." Style="{StaticResource Helper}" Margin="2,6,0,0" />

                <ContentControl Content="{Binding RelayPortError}"
                                ContentTemplate="{StaticResource FieldError}"
                                Focusable="False"
                                Visibility="{Binding RelayPortError, Converter={StaticResource NullToVisibility}}" />
                <ContentControl Content="{Binding PrivateHttpsPortError}"
                                ContentTemplate="{StaticResource FieldError}"
                                Focusable="False"
                                Visibility="{Binding PrivateHttpsPortError, Converter={StaticResource NullToVisibility}}" />
                <ContentControl Content="{Binding PublicPathPrefixError}"
                                ContentTemplate="{StaticResource FieldError}"
                                Focusable="False"
                                Visibility="{Binding PublicPathPrefixError, Converter={StaticResource NullToVisibility}}" />

                <!-- Public Funnel: the three ports Funnel can use. -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsPublicMode, Converter={StaticResource BooleanToVisibility}}">
                  <TextBlock Text="HTTPS port" Style="{StaticResource FieldLabel}" />
                  <ui:SegmentedControl HorizontalAlignment="Stretch"
                                       SelectedValuePath="Tag"
                                       SelectedValue="{Binding PublicHttpsPort}"
                                       AutomationProperties.Name="HTTPS port"
                                       AutomationProperties.AutomationId="{x:Static app:AutomationIds.PublicHttpsPortSelector}">
                    <ListBoxItem Content="443">
                      <ListBoxItem.Tag>
                        <sys:Int32>443</sys:Int32>
                      </ListBoxItem.Tag>
                    </ListBoxItem>
                    <ListBoxItem Content="8443">
                      <ListBoxItem.Tag>
                        <sys:Int32>8443</sys:Int32>
                      </ListBoxItem.Tag>
                    </ListBoxItem>
                    <ListBoxItem Content="10000">
                      <ListBoxItem.Tag>
                        <sys:Int32>10000</sys:Int32>
                      </ListBoxItem.Tag>
                    </ListBoxItem>
                  </ui:SegmentedControl>
                </StackPanel>

                <TextBlock Text="PC address" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <!-- 4 above and below: the field stays 44 high for one line and for two, and grows after that. -->
                <ContentControl Style="{DynamicResource Field.ReadOnly}"
                                Padding="14,4"
                                AutomationProperties.Name="PC address"
                                AutomationProperties.AutomationId="{x:Static app:AutomationIds.SettingsAddressField}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- A long address wraps: it is never cut off. -->
                    <TextBlock x:Name="AddressText"
                               Text="{Binding PcAddress}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <!-- Until Tailscale's name is known, the placeholder is quieter than a real address. -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Type.Mono}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPcAddress}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- 36 in a field of 44: the button adds no height. -->
                    <Button Grid.Column="1"
                            Style="{DynamicResource Button.Icon.Quiet}"
                            Width="36"
                            Height="36"
                            Margin="6,0,-9,0"
                            VerticalAlignment="Center"
                            ui:ButtonAssist.Icon="{StaticResource Icon.Copy}"
                            ui:ButtonAssist.IconSize="18"
                            Foreground="{DynamicResource InkSecondaryBrush}"
                            Command="{Binding CopyAddressCommand}"
                            ToolTip="Copy PC address"
                            AutomationProperties.Name="Copy PC address"
                            Visibility="{Binding HasPcAddress, Converter={StaticResource BooleanToVisibility}}" />
                  </Grid>
                </ContentControl>
                <TextBlock Text="Changing the mode or port changes the PC address. Paired iPhones must scan a new QR to use it."
                           Style="{StaticResource Helper}"
                           Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Style="{DynamicResource Button.Secondary}"
                          Content="Save"
                          Command="{Binding SaveCommand}"
                          AutomationProperties.AutomationId="{x:Static app:AutomationIds.SaveSettingsButton}" />
                  <Button Style="{DynamicResource Button.Quiet}"
                          Margin="8,0,0,0"
                          Content="Discard"
                          Command="{Binding DiscardCommand}"
                          AutomationProperties.AutomationId="{x:Static app:AutomationIds.DiscardSettingsButton}" />
                </StackPanel>
              </StackPanel>

              <!-- Right column: the Tailscale mapping of the mode that is saved. -->
              <StackPanel x:Name="MappingColumn">
                <TextBlock Text="Tailscale mapping" Style="{StaticResource FieldLabel}" />
                <ContentControl x:Name="MappingCard"
                                Style="{DynamicResource Glass.Card}"
                                ui:Glass.CornerRadius="{DynamicResource RadiusField}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:StatusIndicatorView Indicator="{Binding MappingStatus}"
                                              VerticalAlignment="Center"
                                              Announces="True"
                                              AutomationProperties.AutomationId="{x:Static app:AutomationIds.MappingStatus}" />
                      <Button Grid.Column="1"
                              Style="{DynamicResource Button.Primary}"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="Set up connection…"
                              Command="{Binding SetUpMappingCommand}"
                              AutomationProperties.AutomationId="{x:Static app:AutomationIds.SetUpMappingButton}" />
                    </Grid>

                    <!-- Why it is blocked, what to do about Tailscale, or "Save the settings first." -->
                    <TextBlock x:Name="MappingCaptionText"
                               Text="{Binding MappingCaption}"
                               Style="{StaticResource Helper}"
                               Margin="0,8,0,0"
                               Visibility="{Binding MappingCaption, Converter={StaticResource NullToVisibility}}" />

                    <StackPanel Visibility="{Binding MappingCommandText, Converter={StaticResource NullToVisibility}}">
                      <TextBlock Text="What Set up does"
                                 Style="{DynamicResource Type.Micro}"
                                 Foreground="{DynamicResource InkSecondaryBrush}"
                                 Margin="0,12,0,0" />
                      <TextBlock Text="{Binding MappingCommandText}"
                                 Style="{DynamicResource Type.Mono}"
                                 TextWrapping="Wrap"
                                 TextTrimming="None"
                                 Margin="0,4,0,0"
                                 AutomationProperties.AutomationId="{x:Static app:AutomationIds.MappingCommandText}" />
                      <TextBlock Text="{Binding MappingEffectText}" Style="{StaticResource Helper}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Check again only reads. Remove… exists only for a mapping LiveCue created (rule TS-8). -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button Style="{DynamicResource Button.Secondary}"
                              ui:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                              ui:ButtonAssist.IconSize="18"
                              ui:ButtonAssist.IsBusy="{Binding IsCheckingAssistant}"
                              Content="Check again"
                              Command="{Binding CheckMappingCommand}"
                              AutomationProperties.AutomationId="{x:Static app:AutomationIds.CheckMappingButton}" />
                      <Button Style="{DynamicResource Button.Destructive}"
                              Margin="8,0,0,0"
                              Content="Remove…"
                              Command="{Binding RemoveMappingCommand}"
                              CommandParameter="{Binding CurrentOwnedMapping}"
                              Visibility="{Binding CurrentOwnedMapping, Converter={StaticResource NullToVisibility}}"
                              AutomationProperties.AutomationId="{x:Static app:AutomationIds.RemoveMappingButton}" />
                    </StackPanel>
                  </StackPanel>
                </ContentControl>

                <!-- A mapping LiveCue created earlier that still exists but is not the one selected now. -->
                <ItemsControl x:Name="StaleList"
                              ItemsSource="{Binding StaleMappings}"
                              Focusable="False"
                              ButtonBase.Click="OnStaleRemoveClick"
                              AutomationProperties.Name="Earlier mappings"
                              AutomationProperties.AutomationId="{x:Static app:AutomationIds.StaleMappingList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Banner Tone="Warning" Body="{Binding Text}" ActionLabel="Remove…" Margin="0,12,0,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                  Something else forwards to the relay port and LiveCue did not create it. LiveCue never
                  removes it: the row shows the command for the owner to run, and has no button.
                -->
                <ItemsControl x:Name="ExposureList"
                              ItemsSource="{Binding UnownedExposures}"
                              Focusable="False"
                              AutomationProperties.Name="Mappings LiveCue did not create"
                              AutomationProperties.AutomationId="{x:Static app:AutomationIds.UnownedExposureList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,12,0,0">
                        <ui:Banner Tone="Warning" Body="{Binding Text}" />
                        <TextBox Style="{StaticResource CommandField}"
                                 Text="{Binding CommandText, Mode=OneWay}"
                                 Margin="0,6,0,0"
                                 AutomationProperties.Name="Removal command"
                                 Visibility="{Binding CommandText, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{x:Static hosting:MappingTexts.ManualRemovalUnavailable}"
                                   Style="{StaticResource Helper}"
                                   Margin="2,6,0,0"
                                   Visibility="{Binding CommandText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tailscale's configuration could not be read: what is exposed is unknown, not nothing. -->
                <TextBlock x:Name="ExposureUnknown"
                           Text="{Binding ExposureUnknownText}"
                           Style="{StaticResource Helper}"
                           Foreground="{DynamicResource InkPrimaryBrush}"
                           Margin="0,12,0,0"
                           Visibility="{Binding ExposureUnknownText, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="LiveCue shows the command and its effect here and asks once more before running it. It never changes Tailscale when the relay starts or stops, or when settings are saved."
                           Style="{StaticResource Helper}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </ui:TwoColumnPanel>
          </StackPanel>
        </ContentControl>

        <!-- ====================== Assistant and PC speech models ====================== -->
        <ui:TwoColumnPanel x:Name="CheckColumns" Gap="16" StackBelow="820" Margin="0,16,0,0">

          <ContentControl x:Name="AssistantPanel" Style="{DynamicResource Glass.Panel}" Padding="{DynamicResource InsetPanelRows}">
            <StackPanel>
              <Grid Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Assistant"
                           Style="{DynamicResource Type.Headline}"
                           VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
                <Button Grid.Column="1"
                        Style="{DynamicResource Button.Secondary}"
                        Margin="12,0,0,0"
                        ui:ButtonAssist.Icon="{StaticResource Icon.Refresh}"
                        ui:ButtonAssist.IconSize="18"
                        ui:ButtonAssist.IsBusy="{Binding IsCheckingAssistant}"
                        Content="Check again"
                        Command="{Binding CheckAssistantCommand}"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.CheckAssistantButton}" />
              </Grid>

              <StackPanel Margin="12,12,12,8">
                <TextBlock Text="Codex executable path" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{DynamicResource Field.Text}"
                         Tag="Automatic"
                         Text="{Binding CodexPathText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Codex executable path"
                         AutomationProperties.HelpText="Leave empty to let LiveCue find Codex. Otherwise the full path of codex.exe."
                         AutomationProperties.AutomationId="{x:Static app:AutomationIds.CodexPathField}" />
                <ContentControl Content="{Binding CodexPathError}"
                                ContentTemplate="{StaticResource FieldError}"
                                Focusable="False"
                                Visibility="{Binding CodexPathError, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="Leave empty to let LiveCue find Codex. Otherwise the full path of codex.exe."
                           Style="{StaticResource Helper}"
                           Margin="2,6,0,0" />
              </StackPanel>

              <ui:ListRow Glyph="{StaticResource Icon.Terminal}"
                          Title="Codex executable"
                          Subtitle="{Binding CodexPathDetail, TargetNullValue=''}"
                          ShowSeparator="False">
                <ui:StatusIndicatorView Indicator="{Binding CodexPathStatus}"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.CodexPathStatus}" />
              </ui:ListRow>

              <ui:ListRow Glyph="{StaticResource Icon.Key}"
                          Title="Codex sign-in"
                          Subtitle="{Binding CodexLoginDetail, TargetNullValue=''}">
                <ui:StatusIndicatorView Indicator="{Binding CodexLoginStatus}"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.CodexLoginStatus}" />
              </ui:ListRow>

              <!-- The version in use, and whether the containment check was run for it (W-design 5.8). -->
              <ui:ListRow Glyph="{StaticResource Icon.Lock}"
                          Title="Codex version"
                          Subtitle="{Binding CodexVersionDetail, TargetNullValue=''}">
                <ui:StatusIndicatorView Indicator="{Binding CodexVersionStatus}"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.CodexVersionStatus}" />
              </ui:ListRow>
              <!-- Records the owner's statement that the check passed for this version; the app cannot run it. -->
              <Button Style="{DynamicResource Button.Quiet}"
                      HorizontalAlignment="Left"
                      Margin="46,-4,0,4"
                      Content="Mark as checked"
                      Command="{Binding MarkContainmentCheckedCommand}"
                      Visibility="{Binding CanMarkContainmentChecked, Converter={StaticResource BooleanToVisibility}}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.MarkContainmentCheckedButton}" />
            </StackPanel>
          </ContentControl>

          <ContentControl x:Name="SpeechPanel" Style="{DynamicResource Glass.Panel}" Padding="{DynamicResource InsetPanelRows}">
            <StackPanel>
              <!-- As high as the header beside it, which holds a button. -->
              <Grid Margin="12,12,12,0" MinHeight="{DynamicResource ButtonHeightRegular}">
                <TextBlock Text="PC speech models"
                           Style="{DynamicResource Type.Headline}"
                           VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
              </Grid>

              <StackPanel Margin="12,12,12,8">
                <TextBlock Text="Speech lab folder" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{DynamicResource Field.Text}"
                         Tag="Automatic"
                         Text="{Binding LabFolderText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Speech lab folder"
                         AutomationProperties.HelpText="Leave empty to use the asr folder beside LiveCue."
                         AutomationProperties.AutomationId="{x:Static app:AutomationIds.SpeechLabFolderField}" />
                <ContentControl Content="{Binding LabFolderError}"
                                ContentTemplate="{StaticResource FieldError}"
                                Focusable="False"
                                Visibility="{Binding LabFolderError, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="Leave empty to use the asr folder beside LiveCue."
                           Style="{StaticResource Helper}"
                           Margin="2,6,0,0" />
              </StackPanel>

              <ui:ListRow Glyph="{StaticResource Icon.Folder}"
                          Title="Lab folder"
                          Subtitle="{Binding LabFolderDetail, TargetNullValue=''}"
                          ShowSeparator="False">
                <ui:StatusIndicatorView Indicator="{Binding LabFolderStatus}"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.SpeechLabStatus}" />
              </ui:ListRow>

              <ui:ListRow Glyph="{StaticResource Icon.Chip}"
                          Title="Loaded model"
                          Subtitle="As last reported by the relay">
                <ui:StatusIndicatorView Indicator="{Binding LoadedModelStatus}"
                                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.LoadedModelStatus}" />
              </ui:ListRow>

              <TextBlock Text="{Binding SpeechCaption}" Style="{StaticResource Helper}" Margin="12,8,12,8" />
            </StackPanel>
          </ContentControl>
        </ui:TwoColumnPanel>

        <!-- ============================ Screen capture ============================ -->
        <ContentControl x:Name="CapturePanel" Style="{DynamicResource Glass.PanelCompact}" Margin="0,16,0,0">
          <!-- A form field like the others: it is saved by Save, and the window follows the saved value. -->
          <CheckBox IsChecked="{Binding HideFromScreenCapture}"
                    AutomationProperties.Name="Hide this window from screen capture"
                    AutomationProperties.HelpText="Screen sharing, recordings and screenshots show an empty area instead of this window."
                    AutomationProperties.AutomationId="{x:Static app:AutomationIds.HideFromCaptureToggle}">
            <StackPanel>
              <TextBlock Text="Hide this window from screen capture" Style="{DynamicResource Type.Headline}" />
              <TextBlock Text="Screen sharing, recordings and screenshots show an empty area instead of this window."
                         Style="{StaticResource Helper}" />
            </StackPanel>
          </CheckBox>
        </ContentControl>

        <!-- ================================== About ================================== -->
        <ContentControl x:Name="AboutPanel" Style="{DynamicResource Glass.PanelCompact}" Margin="0,16,0,0">
          <ui:SplitRowPanel>
            <StackPanel Orientation="Horizontal">
              <StackPanel>
                <TextBlock Text="Version" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource InkSecondaryBrush}" />
                <TextBlock Text="{Binding Version}"
                           Style="{DynamicResource Type.Label}"
                           Typography.NumeralAlignment="Tabular"
                           Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Margin="32,0,0,0">
                <TextBlock Text="Licence" Style="{DynamicResource Type.Micro}" Foreground="{DynamicResource InkSecondaryBrush}" />
                <TextBlock Text="MIT" Style="{DynamicResource Type.Label}" Margin="0,4,0,0" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-14,0,-14,0">
              <Button Style="{DynamicResource Button.Quiet}"
                      Content="Third-party notices"
                      Command="{Binding OpenNoticesCommand}"
                      AutomationProperties.AutomationId="{x:Static app:AutomationIds.ThirdPartyNoticesButton}" />
              <Button Style="{DynamicResource Button.Quiet}"
                      ui:ButtonAssist.Icon="{StaticResource Icon.External}"
                      Content="Source code on GitHub"
                      Command="{Binding OpenSourceCommand}"
