<UserControl x:Class="LiveCue.Desktop.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LiveCue.Desktop"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             Focusable="False">

  <!--
    Settings (docs/design/03-windows-screens.md, section 5): one scrolling page of panels. First
    version: the Connection panel shows the saved values as rows, and About shows the version. The
    editable form, the Tailscale mapping, Assistant and PC speech models arrive with the page
    (W-design 5.8).
  -->
  <DockPanel>

    <Grid DockPanel.Dock="Top" MinHeight="{DynamicResource SizePageHeader}" Margin="4,0,4,16">
      <TextBlock Text="Settings" Style="{DynamicResource Type.Display}" VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer Style="{DynamicResource Page.Scroller}">
      <StackPanel Margin="{DynamicResource InsetScrollerContent}">

        <ContentControl Style="{DynamicResource Glass.Panel}" Padding="{DynamicResource InsetPanelRows}">
          <StackPanel>
            <Grid Margin="16,10,12,6">
              <TextBlock Text="Connection" Style="{DynamicResource Type.Headline}" VerticalAlignment="Center" />
              <ui:StatusChip HorizontalAlignment="Right" Kind="Neutral" Text="Applies the next time the relay starts" />
            </Grid>

            <ui:ListRow Glyph="{StaticResource Icon.Link}"
                        Title="Mode"
                        Subtitle="{Binding ModeExplanation}"
                        ShowSeparator="False"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.ConnectionModeSelector}">
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Private tailnet" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Mode}" Value="Public">
                        <Setter Property="Text" Value="Public Funnel" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </ui:ListRow>

            <ui:ListRow Glyph="{StaticResource Icon.Monitor}"
                        Tone="Neutral"
                        Title="Private HTTPS port"
                        Subtitle="The port of the PC address your iPhone uses inside your tailnet"
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.PrivateHttpsPortField}">
              <TextBlock Text="{Binding PrivateHttpsPortText}" Typography.NumeralAlignment="Tabular" />
            </ui:ListRow>

            <ui:ListRow Glyph="{StaticResource Icon.Monitor}"
                        Tone="Neutral"
                        Title="Relay port"
                        Subtitle="On this PC only. Nothing outside this PC can reach it directly."
                        AutomationProperties.AutomationId="{x:Static app:AutomationIds.RelayPortField}">
              <TextBlock Text="{Binding RelayPortText}" Typography.NumeralAlignment="Tabular" />
            </ui:ListRow>
          </StackPanel>
        </ContentControl>

        <ContentControl Style="{DynamicResource Glass.Panel}" Padding="{DynamicResource InsetPanelRows}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="About" Style="{DynamicResource Type.Headline}" Margin="16,12,16,6" />

            <ui:ListRow Glyph="{StaticResource Icon.Info}"
                        Tone="Neutral"
                        Title="Version"
                        Subtitle="LiveCue for Windows"
                        ShowSeparator="False">
              <TextBlock Text="{Binding Version}" Typography.NumeralAlignment="Tabular" />
            </ui:ListRow>

            <ui:ListRow Glyph="{StaticResource Icon.Check}"
                        Tone="Neutral"
                        Title="Licence"
                        Content="MIT" />
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
