<UserControl x:Class="LiveCue.Desktop.Settings.MappingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LiveCue.Desktop"
             xmlns:ui="clr-namespace:LiveCue.Desktop.Controls"
             Focusable="False"
             AutomationProperties.Name="{Binding Title}">

  <!--
    The set-up and remove confirmation of a Tailscale mapping (docs/design/03-windows-screens.md, 6.2;
    W-design 5.9). The only way a mapping is ever written: the command in the field is exactly the one
    that runs if the dialog is confirmed (rule TS-9), and it can be selected and copied.

      Set up   "Set up" is the primary and the default button, so it has the initial focus
      Remove   "Remove" is the destructive primary and not the default: Cancel has the initial focus
               and Enter never confirms

    Only the button of the dialog's own action exists in it. On a failure the dialog stays, with the
    mapping manager's text in a danger banner under the command.
  -->

  <UserControl.Style>
    <Style TargetType="UserControl">
      <Setter Property="AutomationProperties.AutomationId" Value="{x:Static app:AutomationIds.SetUpMappingDialog}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
          <Setter Property="AutomationProperties.AutomationId" Value="{x:Static app:AutomationIds.RemoveMappingDialog}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Style>

  <UserControl.Resources>
    <DataTemplate x:Key="ConfirmSetUp">
      <Button Style="{DynamicResource Button.Primary}"
              Content="{Binding ConfirmLabel}"
              IsDefault="True"
              ui:ButtonAssist.IsBusy="{Binding IsBusy}"
              Command="{Binding ConfirmCommand}" />
    </DataTemplate>
    <DataTemplate x:Key="ConfirmRemove">
      <Button Style="{DynamicResource Button.DestructivePrimary}"
              Content="{Binding ConfirmLabel}"
              ui:ButtonAssist.IsBusy="{Binding IsBusy}"
              Command="{Binding ConfirmCommand}" />
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Title}"
                 Style="{DynamicResource Type.Title}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 TextTrimming="None"
                 AutomationProperties.HeadingLevel="Level1" />
      <!-- 36 in a line of 28, drawn out to the card's inset: it adds no height and its glyph ends on the text edge. -->
      <Button Grid.Column="1"
              Style="{DynamicResource Button.Icon.Quiet}"
              Width="36"
              Height="36"
              Margin="12,-4,-9,-4"
              VerticalAlignment="Top"
              ui:ButtonAssist.Icon="{StaticResource Icon.Close}"
              ui:ButtonAssist.IconSize="18"
              Command="{Binding CancelCommand}"
              ToolTip="Close"
              AutomationProperties.Name="Close" />
    </Grid>

    <TextBlock Text="{Binding Intro}" Style="{DynamicResource Type.Body}" Margin="0,12,0,6" />

    <!-- The exact command, verbatim. Read-only, so the first field of the dialog is not a place to type. -->
    <TextBox x:Name="CommandField"
             Style="{DynamicResource Field.Text}"
             Text="{Binding CommandText, Mode=OneWay}"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="False"
             FontFamily="{DynamicResource FontFamilyMono}"
             FontSize="{DynamicResource TypeMonoSize}"
             TextWrapping="Wrap"
             Padding="14,12"
             AutomationProperties.Name="{Binding Intro}" />

    <TextBlock Text="{Binding EffectText}"
               Style="{DynamicResource Type.Body}"
               TextWrapping="Wrap"
               TextTrimming="None"
               Margin="0,12,0,0" />

    <ui:Banner Model="{Binding Failure}" Margin="0,12,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Style="{DynamicResource Button.Secondary}"
              Content="Cancel"
              IsCancel="True"
              Command="{Binding CancelCommand}" />
      <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False" Margin="8,0,0,0">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource ConfirmSetUp}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource ConfirmRemove}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </StackPanel>
  </StackPanel>
</UserControl>
