<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The LiveCue relay: the protocol 2 server, bound to loopback, that any .NET process can host. No WPF, no settings file, no Tailscale knowledge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel comes from the shared framework, so there is no package to restore or pin for it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pairing QR matrix, and DPAPI for the protected copy of the pairing token. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two output schemas of protocol 12.5, rewritten into the data folder at each start. -->
    <EmbeddedResource Include="Answers\Schemas\assist.schema.json" LogicalName="LiveCue.Relay.Answers.Schemas.assist.schema.json" />
    <EmbeddedResource Include="Answers\Schemas\summary.schema.json" LogicalName="LiveCue.Relay.Answers.Schemas.summary.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The three launcher scripts of protocol 11.5, linked from asr/ so that there is one source. The relay
      writes its own copies into the data folder's lab\ at each start and never runs a file of the lab folder.
    -->
    <EmbeddedResource Include="..\..\..\asr\Start-ASR-Lab.ps1" Link="LocalModel\Scripts\Start-ASR-Lab.ps1" LogicalName="LiveCue.Relay.LocalModel.Scripts.Start-ASR-Lab.ps1" />
    <EmbeddedResource Include="..\..\..\asr\Stop-ASR-Lab.ps1" Link="LocalModel\Scripts\Stop-ASR-Lab.ps1" LogicalName="LiveCue.Relay.LocalModel.Scripts.Stop-ASR-Lab.ps1" />
    <EmbeddedResource Include="..\..\..\asr\LabCommon.ps1" Link="LocalModel\Scripts\LabCommon.ps1" LogicalName="LiveCue.Relay.LocalModel.Scripts.LabCommon.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seams are internal and reach the tests through this. -->
    <InternalsVisibleTo Include="LiveCue.Relay.Tests" />
  </ItemGroup>

</Project>
