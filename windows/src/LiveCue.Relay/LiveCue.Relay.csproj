<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The LiveCue relay: the protocol 2 server, bound to loopback, that any .NET process can host. No WPF, no settings file, no Tailscale knowledge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel comes from the shared framework, so there is no package to restore or pin for it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the pairing QR matrix and the DPAPI-protected pairing file. Referenced now so restore and publish are proven; first used when pairing is built. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LiveCue.Relay.Tests" />
  </ItemGroup>

</Project>
